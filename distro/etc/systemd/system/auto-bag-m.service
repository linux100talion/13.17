[Unit]
Description=ROS2 bag на борту: с подъёма MAVROS, куски 180 с (включать руками)
After=network.target

[Service]
Type=simple
User=andriy
ExecStart=/bin/bash /home/andriy/mavlogs/auto_bag_m.sh
Restart=on-failure
RestartSec=5

# SIGINT = Ctrl+C: ros2 bag закрывает кусок; большой sqlite с камерой закрывается не мгновенно
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
