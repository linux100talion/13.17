# Дополнительные параметры SITL для GCE / слабого CPU.
# Загружается как второй --add-param-file поверх стандартного gazebo-iris.parm.

# НЕОБХОДИМО 100 (не костыль): физика Gazebo = 250 Гц (max_step_size 0.004),
# значит гироскоп = 250 Гц. ArduCopter требует gyro >= 1.8*loop_rate, поэтому
# loop 400 => нужно 720 Гц гиро => арм блокируется ("Gyro 0 rate 252Hz <
# loop rate*1.8 720Hz" + "Main loop slow 250<400"). loop 100 => нужно 180 Гц,
# есть 250 => ОК. Лимит-цикл крена ~9 Гц чинит lockstep (lock_step=1), не частота
# контура. См. docker/sim/FAQ_rate_loop.md.
SCHED_LOOP_RATE 100

# Отключить автодизарм при потере GCS (в симуляции GCS нет).
FS_GCS_ENABLE 0

# Убрать таймаут дизарма на земле.
DISARM_DELAY 0

# Отключить все pre-arm проверки (в симуляции IMU "несогласованы").
# ⚠️ В ArduPilot 4.8 параметр ПЕРЕИМЕНОВАН: ARMING_CHECK → ARMING_SKIPCHK с
# ИНВЕРСИЕЙ смысла (маска «что ПРОПУСКАТЬ»; −1 = пропустить все немандаторные —
# так в @Description самой прошивки). Прежняя строка `ARMING_CHECK 0` молча
# игнорировалась (та же ловушка, что SYSID_MYGCS → MAV_GCS_SYSID выше), то есть
# ВСЕ чеки реально работали — LV-прогоны армились лишь потому, что с GPS чеки
# честно проходили. Вскрылось на LV=2 (GPS нет с бута): «PreArm: Check mag
# field» бессрочно резал руддер-арм (прогон lv2_replay_20260824_034433, 59 ГБ
# земли). Продублировано в eeprom param_set'ом (eeprom сильнее --defaults).
ARMING_SKIPCHK -1

# Нет RC-входа (запускаем без MAVProxy/джойстика) → radio/throttle failsafe иначе
# режет арм И сбрасывает даже force-arm. Отключаем.
FS_THR_ENABLE 0

# Отключить RC-переключатель полётного режима (канал FLTMODE_CH, дефолт 5).
# Нужен для alt_hold_bootstrap: дрон держим в ALT_HOLD через set_mode + непрерывный
# RC override (20 Гц). При дефолте симулированное радио по каналу 5 каждый тик
# перебивало set_mode → режим слетал в STABILIZE, а там throttle=1650 ≈ висение и
# дрон не набирал высоту (подтверждено прогоном: «режим=STABILIZE ≠ ALT_HOLD»,
# rel_alt≈0). Ре-ассерт в ноде — недостаточный бэкстоп (остаются окна STABILIZE).
# FLTMODE_CH 0 → режимом управляет только GCS/set_mode. GUIDED/GPS НЕ ломает (тот
# тоже ставится set_mode); GPS-арм упирался в БЮДЖЕТ (ARM_SIM_BUDGET), не в это.
FLTMODE_CH 0

# RC override (alt_hold_bootstrap) проходит, только если sysid отправителя ==
# MAV_GCS_SYSID. ArduCopter: handle_rc_channels_override() молча отбрасывает override
# при msg.sysid != MAV_GCS_SYSID (дефолт 255). MAVROS шлёт как system_id=1 → 1≠255 →
# КАЖДЫЙ override дропался → throttle оставался в min → моторы 1100, дрон не взлетал
# (подтверждено: override ch3=1800 публикуется, /mavros/rc/in пуст, rel_alt≈0).
# ⚠️ В ArduPilot 4.8 параметр ПЕРЕИМЕНОВАН SYSID_MYGCS → MAV_GCS_SYSID. Прежняя строка
# `SYSID_MYGCS 1` прошивкой 4.8 ИГНОРИРОВАЛАСЬ (несуществующий параметр отвергается при
# загрузке), MAV_GCS_SYSID оставался 255 → фикс не действовал. Подтверждено pymavlink
# A/B-тестом напрямую к SITL (tcp:5762): override от sysid=1 → chan3=1000 (ОТБРОШЕН),
# от sysid=255 → chan3=1800 (ПРИНЯТ); MAV_GCS_SYSID читался как 255, SYSID_MYGCS — нет.
# Ставим 1 = system_id MAVROS. Арм/setpoint НЕ гейтятся sysid (GPS-полёт работал при
# sysid 1), ломается ТОЛЬКО override. Свежесть override держит wall-таймер 20 Гц в
# alt_hold_bootstrap.py (sim-таймер давал ~1.4 Гц wall при RTF 0.07).
MAV_GCS_SYSID 1

# Виртуальный safety-switch по умолчанию «взведён» (обычно снимается через
# MAVProxy, которого у нас нет) → блокирует арм вне ARMING_CHECK. Снимаем.
BRD_SAFETY_DEFLT 0

# --- Мёртвая зона RC roll/pitch/yaw = 0 (для excite-override в alt_hold_bootstrap) ---
# Симптом: дрон в EXCITE летит ИДЕАЛЬНО ровно (наклон ±0.3° из bag, std 0.06°) и
# планирует за край сцены; изменение BS_EXCITE (40→12) и BS_EXCITE_PERIOD поведения
# НЕ меняло. Причина: get_pilot_desired_lean_angles() гонит RC через get_control_in(),
# который вырезает мёртвую зону RCx_DZ (дефолт ~30 PWM). Наш мягкий override
# (±12 PWM от центра 1500) целиком ПОПАДАЛ в мёртвую зону → FCU видел «стик в центре»
# → нулевой наклон → ALT_HOLD держал уровень → дрон коастил по остаточной скорости.
# excite=40 был на грани зоны (>30) → чуть работал (тогда и врезался в дом).
# Подтверждено таймлайном attitude из bag: весь EXCITE pitch/roll std<0.4°.
# Обнуляем зону roll(1)/pitch(2)/yaw(4) → override отрабатывает любой малый наклон,
# мягкая раскачка/торможение становятся управляемыми. Throttle(3) НЕ трогаем
# (его DZ задаёт зону «держать высоту» в ALT_HOLD).
RC1_DZ 0
RC2_DZ 0
RC4_DZ 0

# Арм режется "Arm: Gyros inconsistent" — два симулированных IMU расходятся по
# гиро (на низком RTF / из-за IMU-timesync обвязки), а проверка консистентности
# стреляет даже при ARMING_CHECK 0. Оставляем ОДИН IMU — сравнивать нечего.
SIM_IMU_COUNT 1
INS_USE2 0
INS_USE3 0

# Обязательную "Arm: 3D Accel calibration needed" (ARMING_CHECK её НЕ выключает,
# на свежем eeprom без MAVProxy аксель не откалиброван) снимаем НЕ параметрами
# (голые INS_ACCOFFS/ACCSCAL не проставляют ID+флаг калибровки), а простой
# level-cal командой PREFLIGHT_CALIBRATION(param5=4) из nav_up.sh при бутстрапе.

# --- Гашение лимит-цикла крена ~9 Гц (см. docker/sim/FAQ_rate_loop.md) ---
# FFT прогона "после lockstep" показал: lockstep дрожь НЕ убрал (roll RMS 80.6→70 °/с,
# тот же ~9 Гц), и трясёт ТОЛЬКО крен (pitch 11, yaw 15 °/с). Значит корень не в
# глобальном тайминге, а в перетянутом контуре КРЕНА для текущей связки (loop 100 Гц
# + задержки sim; родной roll-rate PID считан под 400 Гц). Режем усиление roll-rate
# вдвое — снижение gain гасит лимит-цикл при ЛЮБОЙ его природе (и gain-, и phase-margin).
# Фильтр гиро (INS_GYRO_FILTER 20) НЕ трогаем: его понижение добавит фазовую задержку
# и может УХУДШИТЬ. Pitch/yaw не трогаем — спокойны. Дефолты мультикоптера: P0.135 D0.0036.
# Итерация 2 (bootstrap 960×540): FFT гиро из bag показал ОСТАТОЧНЫЙ лимит-цикл
# крена ~8.5 Гц, roll RMS ~10 °/с в фазе excite (при P=0.0675) + расхождение/кувырок
# к посадке. Снижаем усиление ещё (×0.67) — добить остаточную раскачку. (IMU 24 Гц,
# Найквист 12 → пик может быть алиасом; источник высокочастотного гиро ограничен.)
ATC_RAT_RLL_P 0.045
ATC_RAT_RLL_D 0.0012

# --- ЭКСПЕРИМЕНТ A4c: ПОДПОРКА под ложное гиро-смещение EK3 (знак исправлен) ---
# Задача: борт со стиками в центре улетает. Наклон уезжает РАМПОЙ, равной ошибке
# AHRS-гироскопа (арифметика закрыта: A4 рампа 0.187 при ошибке 0.186; A4b 0.538 при 0.511).
#
# Что уже выяснено (src/control/ToDo.md факты 2c/2d, прогоны A4_bias / A4b_gyrofix):
#   СЫРОЙ INS (data_raw): земля −0.184, воздух −0.217 °/с → разница 0.03 → ДАТЧИК ИСПРАВЕН
#   AHRS      (data):     земля −0.176, воздух −0.511 °/с → разница 0.34 → врёт ОЦЕНЩИК
# (−0.18 на земле в обоих — ровно инъекция A4b, см. ниже. Вычтя её: собственная ошибка
# сырого гироскопа +0.005 на земле и −0.028 в воздухе, то есть датчик точен везде.)
# Ложное гиро-смещение ~0.32 °/с рождает EK3 ПОСЛЕ ОТРЫВА; в сыром сигнале его нет.
#
# ЗНАК. A4b ставил −0.0033 из посылки «ArduPilot вычитает offset». Посылка НЕВЕРНА:
# ошибка на земле сдвинулась с −0.002 на −0.184, то есть ровно НА инъекцию и в ТУ ЖЕ
# сторону — offset прибавляется. Стало втрое хуже (31.9 м/с против 14.3). Ставим +0.0033.
#
# ⚠️ Это ПОДПОРКА, а не лечение: параметр сдвигает сырой сигнал одинаково на земле и в
# воздухе, а ломается только воздух. Ожидаемая цена — испорченный верный ноль на земле
# (+0.19 °/с там, где было 0.005). Смысл прогона — узнать, СКОЛЬКО рампы снимается таким
# способом; лечение причины лежит в EK3 (EK3_GBIAS_P_NSE, здоровье фузии GPS).
# ИТОГ ЭКСПЕРИМЕНТА: ОТКАЧЕНО В НОЛЬ, вредит при ЛЮБОМ знаке.
#            инъекция    рампа наклона    v за ~30 с
#   A4           0          0.187 °/с       14.3 м/с   ← базовый, лучший
#   A4b       −0.189       0.538 °/с       31.9 м/с
#   A4c       +0.189       0.425 °/с       27.0 м/с
# Причина: EK3 не «поглощает» поправку, а дестабилизируется от сдвига входа в обе стороны
# (его вклад в воздухе: −0.16 без инъекции, −0.294 при минусе, −0.628 при плюсе).
# Датчик при этом исправен: сырая ошибка −0.026 на земле и −0.029 в воздухе (A4c).
# Параметр НЕ ВОЗВРАЩАТЬ. Лечить надо оценщик, не датчик.
# INS_GYROFFS_Y 0

# --- ЭКСПЕРИМЕНТ A4d: запретить EK3 двигать оценку смещения гироскопа ---
# Разбор (ToDo факты 2c/2d): датчик ИСПРАВЕН — собственная ошибка сырого гироскопа
# −0.026 °/с на земле и −0.029 в воздухе (это 1.7° за минуту, летать можно). А до
# автопилота доезжает ошибка −0.19 °/с (11° за минуту), потому что EK3 поверх верного
# сигнала вносит выдуманную поправку на «смещение гироскопа».
# Откуда она берётся: без источника скорости наклон и смещение гироскопа НЕНАБЛЮДАЕМЫ
# (акселерометр у мультикоптера смотрит вдоль тяги и показывает горизонт при любом
# наклоне). Фильтр тогда опирается на допущение «раз опоры нет, значит стою», оно
# противоречит реальному разгону, и противоречие он списывает в смещение гироскопа.
# EK3_GBIAS_P_NSE — процессный шум этого состояния, то есть насколько фильтру позволено
# его двигать. Ставим МИНИМУМ диапазона (1e-5 против дефолтных 1e-3, в 100 раз меньше):
# оценка примерзает к значению, полученному на земле, где акселерометр честен.
# ОЖИДАНИЕ: рампа наклона падает с 0.187 °/с до уровня самого железа, ~0.03 °/с (в 6 раз);
# запас времени до упора демпфера растёт с 59 с до ~6 минут.
# ЦЕНА: если смещение гироскопа реально поплывёт (температура), фильтр это не отследит.
# В симуляции такого нет; на боевом борту — отдельный вопрос.
EK3_GBIAS_P_NSE 0.00001

# --- Стрим IMU в MAVROS ---
# /mavros/imu/data_raw в части прогонов приходил ПУСТЫМ (0 сообщений). Причина и
# фикс — НЕ здесь: статические частоты телеметрии (MAVx_RAW_SENS, бывш. SRx_*) в
# этой прошивке для router-канала НЕ применяются (проверено — не помогает). FCU
# стримит IMU только по рантайм-запросу REQUEST_DATA_STREAM. Его шлёт nav_up.sh
# через /mavros/set_stream_rate — там и сделан надёжный вызов (ждём коннект ПО
# ФАКТУ + ретраи, вместо прежнего фикс. sleep 20, который и ронял IMU на медленном
# старте). См. docker/sim/scripts/nav_up.sh.

# --- Приём VISION_* по MAVLink (AP_VisualOdom) — ОПТ-ИН, по умолчанию ВЫКЛ ---
# Нужен для отдачи скорости IPM в EKF (BS_VISION_VEL=1: нода публикует
# VISION_SPEED_ESTIMATE, сама ставит EK3_SRC1_VELXY=6 в рантайме и возит нули
# на земле). Драйвер инициализируется ТОЛЬКО на буте — поэтому параметр здесь.
# ⚠️ НЕ ДЕРЖАТЬ ВКЛЮЧЁННЫМ ПОСТОЯННО: с VISO_TYPE=1 арм требует живых VISION-
# данных ОБЯЗАТЕЛЬНЫМ чеком («Arm: VisOdom: not healthy» — ARMING_CHECK 0 его
# НЕ снимает, проверено 2026-08-18: два ARM_FAIL) — любой прогон без фида
# (liftland, make arm, BS_STAB без перцепции) перестаёт армиться.
# Для vision-прогона: раскомментировать → прогон → закомментировать обратно.
# ⚠️ EK3_SRC1_VELXY, выставленный нодой, ПЕРСИСТИТСЯ в eeprom — нода при
# BS_VISION_VEL=0... не трогает его; после vision-серии вернуть 3 руками
# (pymavlink param_set) или make sitl-cal-заново.
# Vision-серия 2026-08-19 закрыта: доказаны фьюжн VINS-позы в EK3, GPS-denied
# в полёте и БЕЗЖПСНЫЙ БУТ (боевой профиль: SIM_GPS1_ENABLE=0 в eeprom +
# BS_SET_ORIGIN=1 + BS_VISION_VEL=1 + BS_VISION_POSE_SRC=extern + BS_ALT_SRC=baro).
# Для новой серии: раскомментировать + env выше; после серии — назад и вернуть
# SIM_GPS1_ENABLE=1 в eeprom руками (персистится).
# LV-серия (штатный LOITER-на-VINS) закрыта 2026-08-19: LOITER_DONE (LV5) +
# A/B против VinsHold (LV7), итоги — laptop_move.md §3. Для LV-прогонов
# раскомментировать (без него «Loiter failed: requires position», урок LV1);
# ПОСЛЕ — назад: с VISO_TYPE=1 прогон без vision-фида не армится
# («VisOdom: not healthy» — поймано freefly-полётом сразу после серии).
# ВКЛЮЧЁН для freefly-LV (живой пилот, BS_FF_LOITER=1: центр CH6 = LOITER).
# ⚠️ VISO_TYPE теперь ЖИВЁТ В EEPROM (записан param_set'ом 2026-08-19, при
# уборке после LV-серии) — а eeprom СИЛЬНЕЕ этой строки: --defaults применяется
# только к параметрам, которых в eeprom НЕТ (freefly-полёт с parm=1 отлетал с
# фактическим 0: FCU не получил ни одной vision-позы, «requires position»).
# Переключать VISO_TYPE отныне через pymavlink param_set + ребут SITL
# (fresh-start); строка ниже — документация желаемого состояния, не механизм.
VISO_TYPE 1
