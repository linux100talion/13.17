# Локальный профиль БОКСА (docker/sim/.env). Его читают ДВОЕ: docker compose
# (интерполяция ${...} в docker-compose*.yml; применяется при СОЗДАНИИ
# контейнера — fresh-start) и src/lab/freefly_lv.sh (служебные ключи прогона:
# LV, RES, KEEP_BAG…; env снаружи всегда сильнее). Шпаргалка — docker/sim/env.md.
#
# ЭТАЛОН — env.default (коммитится в git). Сам .env НЕ коммитится (.gitignore):
# при отсутствии создаётся копией env.default автоматически (make build/
# restart-all/fresh-start или freefly_lv.sh) — свежий клон стартует со штатными
# дефолтами без ручной возни. Машинные правки — в .env (не перетирается),
# менять дефолт ПРОЕКТА — в env.default.
#
# ⚠️ РУЧЕК НОДЫ (BS_*) И ВЕТРА (WIND_*) ЗДЕСЬ НЕТ с 2026-09-07: они живут ТОЛЬКО в
# профилях src/control/profiles (список PROFILES держит cmd/<имя>/<имя>.sh), а
# freefly_lv.sh строки BS_* из .env игнорирует с предупреждением. Здесь — только
# то, что ест compose (машина, образ, мир) и служебное freefly_lv.

# Путь к форку VINS-MONO-ROS2 (ветка 1317_debug) на ХОСТЕ: живёт вне репы,
# монтируется bind-mount'ом в nav как /root/sim_ws/src/vins_oss.
# ⚠️ МАШИННО-ЗАВИСИМО: на GCE-боксе форк лежит в /root/VINS-MONO-ROS2
# (это и дефолт compose) — поправь под свой бокс.
VINS_SRC=/home/andriy/VINS-MONO-ROS2

# Архитектура CUDA для сборки OpenCV в образе nav. RTX 4050 Max-Q = Ada = 8.9.
# Одна арка вместо четырёх дефолтных — сборка заметно быстрее
# ⚠️ МАШИННО-ЗАВИСИМО: под GPU своего бокса (compute capability из nvidia-smi)
CUDA_ARCH_BIN=8.9

# Мир по умолчанию для всех прогонов: вариант с МЕЛКОЙ фактурой земли
# (grass_plane_fine, texel 3.7 мм) — зрение живёт у земли. Базовый мир —
# закомментировать строку. Применяется при СОЗДАНИИ контейнера (fresh-start).
WORLD=/root/worlds/mili_fortress_fine.sdf

# Положение камеры на корпусе — бортовой конфиг VINS (путь ОТ КОРНЯ РЕПО). Из его
# extrinsicRotation/Translation вычисляются поза камеры дрона в Gazebo, экстринсики
# VINS сима и поворот/наклон канала вида сверху (демпфер). Другая камера = другой
# yaml. Смена пути — fresh-start; правка самого файла — restart-all.
CAM_CFG=distro/home/andriy/vins_ws/src/VINS-MONO-ROS2/config_pkg/config/config.yaml

# Центр масс борта вдоль продольной оси, в ДОЛЯХ полубазы моторов (минус — назад; sim_up.sh
# сдвигает центр масс base_link с учётом масс остальных звеньев). Реальный борт (hw.txt,
# «ЗАМЕР В ПОЛЁТЕ»: задняя пара 53.8 % тяги по rpm²) — −0.0755; здесь на 15 % больше: −0.0868
# (iris: полубаза 0.13 м → центр масс борта на 1.13 см позади). Пусто/0 — без сдвига. fresh-start.
COM_X_FRAC=-0.0868

# Профиль eeprom SITL для freefly_lv.sh (шаг 1, sitl_lv_profile.py): LV=2 — GPS
# отсутствует с бута (модель реального борта: SIM_GPS1_ENABLE=0, EK3_SRC1_POSXY=6,
# VISO_TYPE=1). Ручки ноды под LV=2 (BS_GPS_DENIED/SET_ORIGIN/ALT_SRC…) запечены в
# профиле loiter/baseline.txt; SF-мастер, кнопка SA — mission/baseline.txt.
LV=2
