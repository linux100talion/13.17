# Локальный профиль БОКСА (docker/sim/.env). Его читают ДВОЕ: docker compose
# (интерполяция ${...} в docker-compose*.yml; применяется при СОЗДАНИИ
# контейнера — fresh-start) и src/lab/freefly_lv.sh (слой дефолтов профиля
# полёта; env снаружи всегда сильнее). Шпаргалка — docker/sim/env.md.
#
# ЭТАЛОН — env.default (коммитится в git). Сам .env НЕ коммитится (.gitignore):
# при отсутствии создаётся копией env.default автоматически (make build/up/
# restart-all/fresh-start или freefly_lv.sh) — свежий клон стартует с боевыми
# дефолтами без ручной возни. Машинные правки — в .env (не перетираются);
# менять дефолт ПРОЕКТА — в env.default.

# Путь к форку VINS-MONO-ROS2 (ветка 1317_debug) на ХОСТЕ: живёт вне репы,
# монтируется bind-mount'ом в nav как /root/sim_ws/src/vins_oss.
# ⚠️ МАШИННО-ЗАВИСИМО: на GCE-боксе форк лежит в /root/VINS-MONO-ROS2
# (это и дефолт compose) — поправь под свой бокс.
VINS_SRC=/home/andriy/VINS-MONO-ROS2

# Архитектура CUDA для сборки OpenCV в образе nav. RTX 4050 Max-Q = Ada = 8.9.
# Одна арка вместо четырёх дефолтных — сборка заметно быстрее.
# ⚠️ МАШИННО-ЗАВИСИМО: под GPU своего бокса (compute capability из nvidia-smi).
CUDA_ARCH_BIN=8.9

# Мир по умолчанию для всех прогонов: вариант с МЕЛКОЙ фактурой земли
# (grass_plane_fine, texel 3.7 мм) — зрение живёт у земли. Базовый мир —
# закомментировать строку. Применяется при СОЗДАНИИ контейнера (fresh-start).
WORLD=/root/worlds/mili_fortress_fine.sdf

# Профиль freefly_lv.sh (читает САМ скрипт; env снаружи сильнее):
# LV=2 — GPS отсутствует с бута (модель боевого борта), BS_SF_MASTER=1 — схема
# «SF-мастер»: SF (CH7) = мастер сырых стиков, SC (CH6) = потолок лесенки
# демпфер/VinsHold/LOITER (нужен микс SF→CH7 в EdgeTX).
# ⚠️ Реплей СТАРЫХ сценариев (без "sf") — запускать с BS_SF_MASTER=0.
LV=2
BS_SF_MASTER=1

# Кнопка SA (мягкая посадка SoftLand) в /joy пульта проекта: измерено пробником
# src/lab/joystick/js_probe.py 2026-08-30 — buttons[1] (дефолт ноды b0).
# ⚠️ МАШИННО-ЗАВИСИМО (микшер EdgeTX): другой пульт — перемерь пробником.
BS_LAND_JOY=b1

# Ярус LOITER — семантика yaw на ходу (разбор eagle/4), два пути НА ВЫБОР:
#   Путь 1  BS_LOITER_TRACK=1    — стики в ОСЯХ МИРА (TrackHold): yaw вращает
#           только нос, траектория прямая, крена нет (КАНДИДАТ, не доказан).
#   Путь 2  BS_LOITER_BANK_MAX=8 — «нос ведёт траекторию», темп yaw режется по
#           скорости так, что крен виража ≤ 8° (YawBankLimit; на 5 м/с полный
#           разворот ~11 с, на висении темп полный). ДОКАЗАН реплеем ab_bank8
#           2026-09-02: крен ≤ 7° против 13–20.8° eagle/4.
# Эталон = путь 2; путь 1 — поменять значения местами. Рассказ целиком —
# src/control/yawbanklimit.md.
BS_LOITER_TRACK=0
BS_LOITER_BANK_MAX=8

# Ярус 1 — стабилизатор на опоре VINS: DpVins (velocity-каскад, плавная замена
# VinsHold) с 2026-09-03. Гейны kp 40/32 ki 6 vsmooth 0.3 (дефолт ноды) —
# σθ 0.5° РОВНО по всем высотам (уровень демпфера; кампания ab_dpv_* довылизала
# с 1.05° предельного цикла понижением kp). Откат: BS_VINS_STAB=vinshold.
# Разбор — src/control/control.md, серия
# eagle (doc/eagle/eagle.txt), память vinshold-motion-ringing.
BS_VINS_STAB=dpvins

# Настроенные ручки VinsHold из серии eagle (применяются при откате
# BS_VINS_STAB=vinshold; при dpvins инертны). Все ДОКАЗАНЫ полётами:
#   KD_ERR   — kd на ошибке скорости (долг уставки ушёл);
#   I_LATCH  — защёлка трима (рывок после стопа мягче) — DpVins тоже читает;
#   PIN_STOP — гвоздь по остановке (возврат исчез);
#   GZ_KD 80 — kd Gz/Vins-hold (высотный звон исчез);
#   PREDICT  — предиктор позы (микро-плюс, безвреден).
# BS_VINS_VSMOOTH=0 — сглаживание D тупик (откачено, см. env.md).
BS_VINS_KD_ERR=1
BS_VINS_I_LATCH=1
BS_VINS_PIN_STOP=1
BS_GZ_KD=80
BS_VINS_PREDICT=1
BS_VINS_VSMOOTH=0

# Гейт здоровья VINS — уроки lv2_joy_20260905_114248 (разбор src/control/control.md,
# «Гейт здоровья», память dpvins-gust-restart-scale):
#   RESTART_DIVERGE=0 — НЕ рестартовать VINS в полёте по гейту: переинициализация
#           монокуляра в движении — лотерея масштаба (0.14/0.85/1.01/1.01 за
#           четыре рестарта), реборн-VINS с масштабом 0.14 унёс борт ±50 м на
#           максималке. Демоут на демпфер остаётся, демпфер порывы держит.
#   SANE_N=10 — «болен» 10 тиков (0.5 с) подряд вместо 3 (0.15 с): догоняющая
#           пачка одометрии после стопора эстиматора держала |v|>3 ровно
#           0.1–0.15 с и роняла ярус ложно.
# Оба — теперь и дефолты ноды (config.py); строки здесь фиксируют решение.
BS_VINS_RESTART_DIVERGE=0
BS_VINS_SANE_N=10
