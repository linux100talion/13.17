    {"sticks": {"thr": 0.5}, "note": "взлёт на 5 м"},
    {"wait_alt": {"gte": 4.5, "timeout": 90}},
    {"sticks": {"thr": 0.0}},
    {"sticks": {"pitch": -0.2}, "note": "окно зрелости VINS (ripe_sec=30) — МЯГКИЙ ЧЕЛНОК вместо висения: голое висение после короткого набора выродило init (прогон 1: VINS разнесло 1→20 м/с за 30 с, гейт считает odom, не здравость)"},
    {"hold": 2.5},
    {"sticks": {"pitch": 0.2}},
    {"hold": 2.5},
    {"sticks": {"pitch": -0.2}},
    {"hold": 2.5},
    {"sticks": {"pitch": 0.2}},
    {"hold": 2.5},
    {"sticks": {"pitch": -0.2}},
    {"hold": 2.5},
    {"sticks": {"pitch": 0.2}},
    {"hold": 2.5},
    {"sticks": {"pitch": -0.2}},
    {"hold": 2.5},
    {"sticks": {"pitch": 0.2}},
    {"hold": 2.5},
    {"sticks": {"pitch": 0.0}},
    {"hold": 15.0, "note": "успокоение + добор зрелости → ярус 1 VINSHOLD"},
    {"sticks": {"pitch": -1.0}, "note": "П1: прямая ВПЕРЁД на 5 м (полный стик = уставка 4 м/с)"},
    {"hold": 11.0},
    {"sticks": {"pitch": 0.0}, "note": "отпустили — замер доката"},
    {"hold": 8.0},
    {"sticks": {"thr": 0.5}, "note": "набор 15 м"},
    {"wait_alt": {"gte": 14.5, "timeout": 90}},
    {"sticks": {"thr": 0.0}},
    {"hold": 4.0},
    {"sticks": {"pitch": 1.0}, "note": "П2: прямая НАЗАД (челнок к старту)"},
    {"hold": 11.0},
    {"sticks": {"pitch": 0.0}},
    {"hold": 8.0},
    {"sticks": {"thr": 0.5}, "note": "набор 30 м"},
    {"wait_alt": {"gte": 29.0, "timeout": 120}},
    {"sticks": {"thr": 0.0}},
    {"hold": 4.0},
    {"sticks": {"pitch": -1.0}, "note": "П3: прямая ВПЕРЁД на 30 м"},
    {"hold": 11.0},
    {"sticks": {"pitch": 0.0}},
    {"hold": 8.0},
    {"sticks": {"thr": -0.5}, "note": "снижение"},
    {"wait_alt": {"lte": 0.15, "timeout": 180}},
    {"sticks": {"thr": -1.0}},
    {"hold": 2.0},
    {"disarm": {"timeout": 60}, "note": "руддер-дизарм"}
  ]
